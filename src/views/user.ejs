<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
    <script src="https://kit.fontawesome.com/ecf0edc0d5.js" crossorigin="anonymous"></script>
</head>
<body>
    <div class="container">
        <%- include('partials/sidebar') %>
        <div class="middle" id="profile-content">
            <div id="profile-bar">
                <div><a href="/users">Back</a></div>
                <div></div>
                <div></div>
            </div>
            <div id="profile-banner">

            </div>
            <div id="profile-info">
                <div>
                    <p></p>
                    <form action="/users/<%= user.id %>/toggleFollow">
                        <button type="submit">Follow</button>
                    </form>
                </div>
                <div id="profile-identity">
                    <p><%= user.name %></p>
                    <p>@username</p>
                </div>
                <div id="profile-following">
                    <a href="">
                        <span><%= user.following_count %></span>
                        <span>Following</span>
                    </a>
                    <a href="">
                        <span><%= user.follower_count %></span>
                        <span>Followers</span>
                    </a>
                </div>
            </div>
            <div id="profile-nav">
                <div><a href="/profile">Posts</a></div>
            </div>
            <% userPosts.forEach(post => { %>
                <div class="post">
                    <div><img class="avatar" src="<%= user.avatar %>" alt="PFP"></div>
                    <div class="postInfo">
                        <div class="postHeader">
                            <p><%= post.author_name %></p>
                            <p>Username * <%= new Date(post.created_at).toLocaleDateString();%></p>
                        </div>
                        <div class="postContent">
                            <p><%= post.content %></p>
                        </div>
                        <div class="postReactions">
                            <form action="/home/<%= post.id %>/toggleLike" class="liked" method="POST">
                                <button type="submit"><i class="fa-regular fa-heart"></i> <%= post.like_count %></button>
                            </form>
                            <button onclick="openCreateComment()"><i class="fa-solid fa-comment"></i> <%= post.comment_count %></button>
                            <!-- Create Post Modal -->
                            <div id="createCommentModal" class="modal hidden" >
                                <div class="createComment-modal-content">
                                    <div class="modal-header">
                                        <button onclick="closeCommentModal()">Close</button>
                                        <h2>Create Post</h2>
                                    </div>
                                    <form action="/home/comment" method="POST" class="createCommentForm">
                                        <div class="createLabelDiv">
                                            <label for="content"><%= currentUser.name %></label>
                                            <textarea name="content" id="content" placeholder="Comment"></textarea>
                                        </div>

                                        <button type="submit">Post</button>
                                    </form>
                                    <%- include('partials/errors'); %>
                                </div>
                            </div>
                            <!---->
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
        <%- include('partials/rightbar') %>
    </div>

    
</body>
</html>