<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
    <script src="https://kit.fontawesome.com/ecf0edc0d5.js" crossorigin="anonymous"></script>
</head>
<body>
    <div class="container">
        <%- include('partials/sidebar') %>
        <div class="middle" id="home-content">
            <h1><%= title %></h1>
            <% posts.forEach(post => { %>
                <div class="post">
                    <div class="postInfo">
                        <a href="/home/posts/<%= post.id %>">
                            <div class="postHeader">
                                <div><img class="avatar" src="<%= post.author_avatar %>" alt="PFP"></div>
                                <p><%= post.author_name %></p>
                                <p>Username * <%= new Date(post.created_at).toLocaleDateString();%></p>
                            </div>
                            <div class="postContent">
                                <p><%= post.content %></p>
                            </div>
                        </a>
                        <div class="postReactions">
                            <form action="/home/<%= post.id %>/toggleLike" method="POST">
                                <button type="submit" class="likeButton"><i class="fa-solid fa-heart <%= post.liked ? 'liked': '' %>"></i> <%= post.like_count %></button>
                            </form>
                            <button class="commentButton" onclick="openCreateComment(<%= post.id %>)"><i class="fa-solid fa-comment"></i> <%= post.comment_count %></button>
                            <!-- Create Comment Modal -->
                            <div id="createCommentModal-<%= post.id %>" class="modal hidden" >
                                <div class="createComment-modal-content">
                                    <div class="modal-header">
                                        <button onclick="closeCommentModal(<%= post.id %>)">Close</button>
                                        <h2>Create Comment</h2>
                                    </div>
                                    <form action="/home/posts/<%= post.id %>/postComment" method="POST" class="createCommentForm">
                                        <div class="createLabelDiv">
                                            <label for="content"><%= currentUser.name %></label>
                                            <textarea name="content" id="content" placeholder="Comment"></textarea>
                                        </div>
                                        <button type="submit">Post Comment</button>
                                    </form>
                                    <%- include('partials/errors'); %>
                                </div>
                            </div>
                            <!---->
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
        <%- include('partials/rightbar') %>
    </div>
    <script>
        function closeCommentModal(postId) {
            const modal = document.getElementById(`createCommentModal-${postId}`);
            modal.classList.add("hidden");
        }

        function openCreateComment(postId) {
            const modal = document.getElementById(`createCommentModal-${postId}`);
            modal.classList.remove("hidden");
        }
    </script>
</body>
</html>