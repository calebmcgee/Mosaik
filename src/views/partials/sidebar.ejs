<div id="sidebar">
    <nav>
        <i class="fa-solid fa-xmark"></i>
        <a href="/home"><i class="fa-solid fa-house"></i></a>
        <a href="/users"><i class="fa-solid fa-users"></i></a>
        <a href="/profile"><i class="fa-solid fa-user"></i></a>
        <button onclick="openCreatePost()"><i class="fa-solid fa-plus"></i></button>
        <!-- Create Post Modal -->
        <div id="createPostModal" class="modal hidden" >
            <div class="createPost-modal-content">
                <div class="modal-header">
                    <button onclick="closePostModal()">Close</button>
                    <h2>Create Post</h2>
                </div>
                <form action="/profile/create" method="POST" class="createPostForm">
                    <div class="createLabelDiv">
                        <label for="content"><%= currentUser.name %></label>
                        <textarea name="content" id="content" placeholder="What's Going On?"></textarea>
                    </div>

                    <button type="submit">Post</button>
                </form>
                <%- include('../partials/errors'); %>
            </div>
        </div>
        <!---->
        <form action="/logout" method="POST">
            <button type="submit"><i class="fa-solid fa-gear"></i></button>
        </form>
    </nav>
</div>

<script>
        const createPostModal = document.querySelector("#createPostModal");

        function closePostModal() {
            createPostModal.classList.add("hidden");
        }


    function openCreatePost() {
        closePostModal();
        createPostModal.classList.remove("hidden");
    }
</script>