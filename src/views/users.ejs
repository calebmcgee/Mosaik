<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
    <script src="https://kit.fontawesome.com/ecf0edc0d5.js" crossorigin="anonymous"></script>
</head>
<body>
    <div class="container">
        <%- include('partials/sidebar') %>
        <div class="middle" id="users-content">
            <h1><%= title %></h1>
            <% for(const user of users){ %>
                <form class="user" action="/users/<%= user.id %>" method="GET">
                    <p>PFP</p>
                    <button type="submit"><%= user.name %></button>
                </form>
            <% }; %>
        </div>
        
        <%- include('partials/rightbar') %>
    </div>

    
</body>
</html>